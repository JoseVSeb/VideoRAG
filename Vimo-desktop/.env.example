# ──────────────────────────────────────────────────────────────────────────────
# Vimo Desktop — Environment Variable Reference
#
# Copy this file to .env (in the same directory) and fill in the values.
# In production (packaged app) place .env next to the app resources.
# All variables are optional and fall back to sensible defaults.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI / LLM API ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Caption (Aliyun Dashscope) API ────────────────────────────────────────────
CAPTION_API_KEY=
CAPTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CAPTION_MODEL=qwen-vl-plus-latest

# ── Model selection ───────────────────────────────────────────────────────────
ASR_MODEL=paraformer-realtime-v2
PROCESSING_MODEL=gpt-4o-mini
ANALYSIS_MODEL=gpt-4o-mini

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory where VideoRAG stores indices, sessions, and downloaded models.
# Defaults to <script_dir>/data when unset.
VIDEORAG_STORE_DIR=

# ── Backend server ────────────────────────────────────────────────────────────
VIDEORAG_HOST=0.0.0.0
VIDEORAG_PORT=64451

# ── Electron / frontend ───────────────────────────────────────────────────────
# Override the backend URL used by the Electron main process.
# Only needed when the backend runs on a non-default host or port.
VIDEORAG_API_URL=
VIDEORAG_API_HOST=localhost
